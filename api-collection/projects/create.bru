meta {
  name: Create Project
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/projects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  json {
    {
      "name": "{{name}}",
      "description": "{{description}}"
    }
  }
}

